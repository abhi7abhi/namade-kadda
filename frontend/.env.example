# Namade Kadda Frontend Environment Configuration
# Copy this file to .env.local for local development.

# When deploying on Vercel, set this in the Vercel Project Dashboard:
# Settings -> Environment Variables -> NEXT_PUBLIC_API_URL
#
# Examples:
# Production: NEXT_PUBLIC_API_URL=https://namade-kadda-backend.onrender.com/api/v1
# Local Dev:   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
