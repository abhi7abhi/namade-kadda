# ===================================================================
# Namade Kadda Backend Environment Configuration Template
# ===================================================================
# Copy this file to backend/.env for local development.
# For production deployment on Render / Railway, configure these keys
# in the hosting platform's Environment Variables dashboard.
# ===================================================================

# --- Application Settings ---
APP_NAME="Namade Kadda API"
APP_ENV="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend domains.
# Wildcard for all Vercel preview deploys (*.vercel.app) is also built-in.
# Example: https://namade-kadda.vercel.app,http://localhost:3000
CORS_ORIGINS="http://localhost:3000,https://*.vercel.app"

# --- MongoDB Atlas Database Connection ---
# Obtain your connection string from MongoDB Atlas:
# Atlas Dashboard -> Databases -> Connect -> Drivers -> Python
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-domain>/"
MONGODB_DATABASE="namade_kadda"

# --- JWT Authentication Security ---
# Generate a secure 32+ character random secret for production:
# Command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM / AI Engine Provider ---
# Keep LLM_PROVIDER="demo" to run with built-in deterministic AI logic without external paid keys.
# Or set provider to "openai", "groq", or "gemini" with the respective API key.
LLM_PROVIDER="demo"
LLM_API_KEY=""
LLM_MODEL="demo-deterministic-v1"
